@host = http://localhost:8000

@emailAdmin = admin@example.com
@passwordAdmin = admin1234

# ============================================================================
# C-13 · Reponer, dar de baja, reusar el ISBN y conservar el título en la venta vieja (Ej. 4)
# ============================================================================
# Precondiciones (en este orden, desde parcial/):
#   1) alembic upgrade head
#   2) python seed.py
#   3) uvicorn main:app
# Ids del seed: libro 3 = Ficciones (ISBN 978-950-00-0003-3, stock 8, vendido x2 en la venta 1);
# editorial 1, género 2, autor 2 (Borges). Este archivo no necesita psql.

### Login del ADMIN
# @name loginAdmin
# @no-cookie-jar
# Esperado: 200
POST {{host}}/auth/login
Content-Type: application/json

{"email": "{{emailAdmin}}", "password": "{{passwordAdmin}}"}

### C-13a · Reponer 5 ejemplares de Ficciones
# @no-cookie-jar
# Esperado: 200 {"libro": {"id": 3, "titulo": "Ficciones", "stock": 13, ...},
#                "movimiento": {"cantidad": 5, "motivo": "Reposición", "venta_id": null, "usuario_id": 1, ...}}
POST {{host}}/libros/3/reponer
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{"cantidad": 5}

### C-13b · Baja lógica de Ficciones
# @no-cookie-jar
# Esperado: 204 (sin cuerpo)
DELETE {{host}}/libros/3
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-13c · Deja de aparecer en el catálogo
# @no-cookie-jar
# Esperado: 200 con "items": [] y "total": 0
GET {{host}}/libros?titulo=ficc

### C-13d (extra) · Ni siquiera por id
# @no-cookie-jar
# Esperado: 404
GET {{host}}/libros/3

### C-13e (extra) · No se puede reponer un libro dado de baja
# @no-cookie-jar
# Esperado: 409 {"detail": "No se puede reponer un libro dado de baja"}
POST {{host}}/libros/3/reponer
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{"cantidad": 1}

### C-13f · Alta de OTRO libro con el mismo ISBN (el viejo está dado de baja)
# @name libroReusado
# @no-cookie-jar
# Esperado: 201 con "id": 6, "isbn": "978-950-00-0003-3" y "stock": 4
# (queda un único libro vigente con ese ISBN: índice único parcial)
POST {{host}}/libros
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{"isbn": "978-950-00-0003-3", "titulo": "Ficciones (reedición)", "precio": "23000.00", "stock_inicial": 4, "editorial_id": 1, "genero_id": 2, "autores": [{"autor_id": 2, "rol": "autor", "orden": 1}]}

### C-13g · Un SEGUNDO vigente con ese ISBN
# @no-cookie-jar
# Esperado: 409 {"detail": "Ya existe un libro vigente con ese ISBN"} (sin texto de la base ni 500)
POST {{host}}/libros
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{"isbn": "978-950-00-0003-3", "titulo": "Otra copia", "precio": "23000.00", "stock_inicial": 1, "editorial_id": 1, "genero_id": 2, "autores": [{"autor_id": 2, "rol": "autor", "orden": 1}]}

### C-13h · La venta vieja sigue mostrando el título «Ficciones»
# @no-cookie-jar
# Esperado: 200 con la venta 1: renglones Rayuela x1 a 25000.00 y «Ficciones» x2 a 22000.00,
# total 69000.00 (el título y el precio vienen del renglón/libro dado de baja, no del nuevo)
GET {{host}}/ventas/1
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-13i (extra) · El libro nuevo sí aparece en el catálogo
# @no-cookie-jar
# Esperado: 200 con total 1: «Ficciones (reedición)», id 6
GET {{host}}/libros?titulo=ficc
