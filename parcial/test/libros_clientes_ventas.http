@host = http://localhost:8000

@emailAdmin = c07.admin@example.com
@emailVendedor = c07.vendedor@example.com
@emailAna = c07.ana@example.com
@emailBruno = c07.bruno@example.com
@emailRosa = c07.rosa@example.com
@passwordAdmin = adminpass123
@passwordProvisoria = provisoria123
@passwordVendedor = vendedor123
@passwordCliente = clientepass123
# Ids de las fichas de cliente de Ana y Bruno (las crea el registro): completar con el
# resultado de la consulta del paso A-08 antes de correr las secciones de ventas.
@clienteAna = 0
@clienteBruno = 0

# ============================================================================
# Precondiciones (C-07 de la hoja de ruta; seed.py llega en C-09)
# ============================================================================
# 1) Base migrada y servidor arriba (C-07 no agrega migraciones):
#      cd parcial
#      alembic upgrade head
#      uvicorn main:app
#
# 2) Vaciar SOLO las filas de prueba de este archivo (prefijo «c07.») antes de correrlo.
#    Los movimientos de stock son solo agregado (disparador 0004): para limpiar las
#    filas de prueba se desactiva el disparador dentro de UNA transacción y se
#    repone antes de confirmar; nunca se tocan los movimientos de datos reales.
#      docker exec libreria-pg psql -U libreria -d libreria -c "
#        BEGIN;
#        ALTER TABLE movimiento_stock DISABLE TRIGGER tg_movimiento_stock_solo_agregado;
#        DELETE FROM movimiento_stock
#          WHERE libro_id IN (SELECT id FROM libro WHERE titulo LIKE 'c07.%')
#             OR usuario_id IN (SELECT id FROM usuario WHERE email LIKE 'c07.%')
#             OR venta_id IN (SELECT id FROM venta WHERE cliente_id IN
#                              (SELECT id FROM cliente WHERE email LIKE 'c07.%'));
#        ALTER TABLE movimiento_stock ENABLE TRIGGER tg_movimiento_stock_solo_agregado;
#        DELETE FROM renglon_venta
#          WHERE venta_id IN (SELECT id FROM venta WHERE cliente_id IN
#                              (SELECT id FROM cliente WHERE email LIKE 'c07.%'))
#             OR libro_id IN (SELECT id FROM libro WHERE titulo LIKE 'c07.%');
#        DELETE FROM venta WHERE cliente_id IN (SELECT id FROM cliente WHERE email LIKE 'c07.%');
#        DELETE FROM perfil_cliente WHERE cliente_id IN (SELECT id FROM cliente WHERE email LIKE 'c07.%');
#        DELETE FROM cliente WHERE email LIKE 'c07.%';
#        DELETE FROM libro_autor WHERE libro_id IN (SELECT id FROM libro WHERE titulo LIKE 'c07.%');
#        DELETE FROM libro WHERE titulo LIKE 'c07.%';
#        DELETE FROM autor WHERE nombre LIKE 'c07.%';
#        DELETE FROM editorial WHERE nombre LIKE 'c07.%';
#        DELETE FROM genero WHERE nombre LIKE 'c07.%';
#        DELETE FROM evento_seguridad WHERE actor LIKE 'c07.%' OR accion LIKE '%c07.%';
#        DELETE FROM intento_acceso WHERE email LIKE 'c07.%';
#        DELETE FROM asignacion_rol WHERE usuario_id IN (SELECT id FROM usuario WHERE email LIKE 'c07.%');
#        DELETE FROM usuario WHERE email LIKE 'c07.%';
#        COMMIT;
#      "
#
# 3) Registrar al ADMIN y a las dos clientes (secciones «Arranque») y darle el
#    rol ADMIN por psql, porque ningún endpoint crea el primer ADMIN (en C-09 lo
#    hace seed.py). El VENDEDOR se da de alta por POST /usuarios:
#      docker exec libreria-pg psql -U libreria -d libreria -c "
#        INSERT INTO asignacion_rol (usuario_id, rol, desde)
#          SELECT id, 'ADMIN', now() FROM usuario WHERE email = 'c07.admin@example.com';"
#
# Invariante de stock (D12), para correr después de cada caso que escribe stock.
# Se limita a los libros de prueba porque el seed.sql del TP carga libros con
# stock y sin movimientos (lo retira C-09). Esperado: 0 filas.
#      SELECT l.id, l.stock, COALESCE(SUM(m.cantidad), 0) AS suma
#        FROM libro l LEFT JOIN movimiento_stock m ON m.libro_id = l.id
#       WHERE l.titulo LIKE 'c07.%'
#       GROUP BY l.id HAVING l.stock <> COALESCE(SUM(m.cantidad), 0);
#
# Cada pedido protegido usa «# @no-cookie-jar» + «Cookie:» para tener varias
# sesiones a la vez. Los ids de las respuestas de ejemplo pueden variar.
# Los títulos de prueba empiezan con «c07.» para no mezclarse con el catálogo real.

# ============================================================================
# Arranque · registros, logins y referencias del catálogo
# ============================================================================

### A-01 · Registro del ADMIN (queda CLIENTE; el ADMIN se da por psql, paso 3)
# @no-cookie-jar
# Esperado: 201
POST {{host}}/auth/registro
Content-Type: application/json

{"email": "{{emailAdmin}}", "nombre": "Admin C07", "password": "{{passwordAdmin}}"}

### A-02 · Registro de Ana (cliente con usuario)
# @no-cookie-jar
# Esperado: 201
POST {{host}}/auth/registro
Content-Type: application/json

{"email": "{{emailAna}}", "nombre": "Ana C07", "password": "{{passwordCliente}}"}

### A-03 · Registro de Bruno (cliente con usuario)
# @no-cookie-jar
# Esperado: 201
POST {{host}}/auth/registro
Content-Type: application/json

{"email": "{{emailBruno}}", "nombre": "Bruno C07", "password": "{{passwordCliente}}"}

# >>> Ahora ejecutá el paso 3 de las precondiciones (psql: rol ADMIN).
# >>> Recién después hacé los logins: el token lleva los roles del momento del login.

### A-04 · Login del ADMIN
# @name loginAdmin
# @no-cookie-jar
# Esperado: 200
POST {{host}}/auth/login
Content-Type: application/json

{"email": "{{emailAdmin}}", "password": "{{passwordAdmin}}"}

### A-05 · Login de Ana
# @name loginAna
# @no-cookie-jar
# Esperado: 200
POST {{host}}/auth/login
Content-Type: application/json

{"email": "{{emailAna}}", "password": "{{passwordCliente}}"}

### A-06 · Login de Bruno
# @name loginBruno
# @no-cookie-jar
# Esperado: 200
POST {{host}}/auth/login
Content-Type: application/json

{"email": "{{emailBruno}}", "password": "{{passwordCliente}}"}

### A-07a · Alta del VENDEDOR con contraseña provisoria
# @name altaVendedor
# @no-cookie-jar
# Esperado: 201 {"id": <id>, ..., "debe_cambiar_password": true}
POST {{host}}/usuarios
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{"email": "{{emailVendedor}}", "nombre": "Vendedor C07", "password": "{{passwordProvisoria}}", "rol": "VENDEDOR"}

### A-07b · Login del VENDEDOR con la provisoria
# @name loginVendedor
# @no-cookie-jar
# Esperado: 200 {"debe_cambiar_password": true, ...}
POST {{host}}/auth/login
Content-Type: application/json

{"email": "{{emailVendedor}}", "password": "{{passwordProvisoria}}"}

### A-07c · El VENDEDOR cambia su contraseña (la MISMA cookie queda al día)
# @no-cookie-jar
# Esperado: 200 {"mensaje": "Contraseña actualizada"}
POST {{host}}/auth/cambiar-password
Content-Type: application/json
Cookie: {{loginVendedor.response.headers.Set-Cookie}}

{"password_actual": "{{passwordProvisoria}}", "password_nueva": "{{passwordVendedor}}"}

### A-08 · Ids de las fichas de Ana y Bruno (psql) → completar @clienteAna y @clienteBruno arriba
#      docker exec libreria-pg psql -U libreria -d libreria -c "
#        SELECT id, email FROM cliente WHERE email IN ('c07.ana@example.com', 'c07.bruno@example.com');"
# Esperado: dos filas (el registro crea la ficha de cada cliente y la vincula a su usuario).
GET {{host}}/health/live

