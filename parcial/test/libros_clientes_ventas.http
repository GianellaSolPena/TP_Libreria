{"isbn": "c07-x1", "titulo": "c07.x1", "precio": "10.00", "stock_inicial": 1, "editorial_id": {{refEditorial.response.body.$.id}}, "genero_id": {{refGenero.response.body.$.id}}, "autores": [{"autor_id": {{refAutor1.response.body.$.id}}, "rol": "autor", "orden": 1}], "stock": 5}

