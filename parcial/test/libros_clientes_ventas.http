### L-14 · Los movimientos no se modifican ni se borran (psql, no hay endpoint)
# Con el id de un movimiento de prueba, ambos fallan por el disparador 0004
# (restrict_violation, SQLSTATE 23001) y la fila queda intacta:
#   UPDATE movimiento_stock SET cantidad = 999 WHERE id = <id>;
#   DELETE FROM movimiento_stock WHERE id = <id>;
#   SELECT cantidad FROM movimiento_stock WHERE id = <id>;   -- sigue igual
GET {{host}}/health/live

### L-15 · Un VENDEDOR no da de alta libros → 403 (antes que la validación)
# @no-cookie-jar
# Esperado: 403 {"detail": "No tenés permiso para esta operación"}
POST {{host}}/libros
Content-Type: application/json
Cookie: {{loginVendedor.response.headers.Set-Cookie}}

{"isbn": "c07-p1", "titulo": "c07.p1", "precio": "10.00", "stock_inicial": 1, "editorial_id": {{refEditorial.response.body.$.id}}, "genero_id": {{refGenero.response.body.$.id}}, "autores": [{"autor_id": {{refAutor1.response.body.$.id}}, "rol": "autor", "orden": 1}]}

