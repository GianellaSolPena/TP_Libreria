# ============================================================================
# LIBROS · alta, PATCH, reposición, movimientos y permisos
# ============================================================================

### L-01 · Alta con el cuerpo del PDF (dos coautores, stock inicial 4)
# @name libPdf
# @no-cookie-jar
# Esperado: 201 {"id": <id>, "stock": 4, "editorial": {...}, "genero": {...}, "autorias": [2 coautores]}
# psql: SELECT cantidad, motivo, venta_id, usuario_id FROM movimiento_stock WHERE libro_id = <id>;
#   → una fila: 4 | Stock inicial | NULL | <id del ADMIN>
POST {{host}}/libros
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{"isbn": "978-950-00-0006-6", "titulo": "c07.Los que aman, odian", "precio": "21000.00", "stock_inicial": 4, "editorial_id": {{refEditorial.response.body.$.id}}, "genero_id": {{refGenero.response.body.$.id}}, "autores": [{"autor_id": {{refAutor1.response.body.$.id}}, "rol": "coautor", "orden": 1}, {"autor_id": {{refAutor2.response.body.$.id}}, "rol": "coautor", "orden": 2}]}

