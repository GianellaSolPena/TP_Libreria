Cookie: {{loginAna.response.headers.Set-Cookie}}

{"isbn": "c07-p2", "titulo": "c07.p2", "precio": "10.00", "stock_inicial": 1, "editorial_id": {{refEditorial.response.body.$.id}}, "genero_id": {{refGenero.response.body.$.id}}, "autores": [{"autor_id": {{refAutor1.response.body.$.id}}, "rol": "autor", "orden": 1}]}

