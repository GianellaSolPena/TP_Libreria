@host = http://localhost:8000

@emailAdmin = authz.admin@example.com
@emailAdmin2 = authz.admin2@example.com
@emailCliente = authz.cliente@example.com
@emailVendedor = authz.vendedor@example.com
@passwordAdmin = adminpass123
@passwordCliente = clientepass123
@passwordProvisoria = provisoria123
@passwordVendedor = vendedor123

# ============================================================================
# Precondiciones (C-06 de la hoja de ruta; seed.py llega en C-09)
# ============================================================================
# 1) Base migrada y servidor arriba:
#      cd parcial
#      alembic upgrade head
#      uvicorn main:app
#
# 2) Vaciar SOLO las filas de prueba de este archivo antes de correrlo (psql):
#      docker exec libreria-pg psql -U libreria -d libreria -c "
#        DELETE FROM evento_seguridad
#          WHERE actor LIKE 'authz.%' OR accion LIKE '%authz.%';
#        DELETE FROM intento_acceso WHERE email LIKE 'authz.%';
#        DELETE FROM asignacion_rol
#          WHERE usuario_id IN (SELECT id FROM usuario WHERE email LIKE 'authz.%');
#        DELETE FROM cliente WHERE email LIKE 'authz.%';
#        DELETE FROM usuario WHERE email LIKE 'authz.%';
#        DELETE FROM libro WHERE titulo LIKE 'authz.%';
#        DELETE FROM genero WHERE nombre LIKE 'authz.%';
#      "
#
# 3) Registrar a los dos ADMIN y a la cliente (secciones «Arranque» de abajo) y
#    darles el rol por psql, porque ningún endpoint crea el primer ADMIN
#    (en C-09 lo hace seed.py):
#      docker exec libreria-pg psql -U libreria -d libreria -c "
#        INSERT INTO asignacion_rol (usuario_id, rol, desde)
#          SELECT id, 'ADMIN', now() FROM usuario
#           WHERE email IN ('authz.admin@example.com','authz.admin2@example.com');
#        INSERT INTO evento_seguridad (cuando, actor, accion)
#          VALUES (now(), 'SISTEMA', 'Carga de los datos iniciales');
#      "
#    (la línea SISTEMA queda como carga inicial; el SQL de limpieza de arriba no la
#     borra a propósito: si ya existe una, no la repitas.)
#
# Los ids de las respuestas de ejemplo pueden variar si la base no está vacía.
# Cada pedido protegido usa «# @no-cookie-jar» + «Cookie:» para tener varias
# sesiones a la vez.

# ============================================================================
# Arranque · registros y logins
# ============================================================================

### A-01 · Registro del ADMIN 1 (queda CLIENTE; el ADMIN se da por psql, paso 3)
# Esperado: 201 {"id": <id>, "email": "authz.admin@example.com", ...,
#                "debe_cambiar_password": false}
POST {{host}}/auth/registro
Content-Type: application/json

{
  "email": "{{emailAdmin}}",
  "nombre": "Admin Uno",
  "password": "{{passwordAdmin}}"
}

### A-02 · Registro del ADMIN 2
# Esperado: 201
POST {{host}}/auth/registro
Content-Type: application/json

{
  "email": "{{emailAdmin2}}",
  "nombre": "Admin Dos",
  "password": "{{passwordAdmin}}"
}

### A-03 · Registro de la cliente
# Esperado: 201
POST {{host}}/auth/registro
Content-Type: application/json

{
  "email": "{{emailCliente}}",
  "nombre": "Cliente Authz",
  "password": "{{passwordCliente}}"
}

# >>> Ahora ejecutá el paso 3 de las precondiciones (psql: ADMIN + línea SISTEMA).
# >>> Recién después hacé los logins: el token lleva los roles del momento del login.

### A-04 · Login del ADMIN 1
# @name loginAdmin
# Esperado: 200 {"mensaje": "Sesión iniciada", "debe_cambiar_password": false, ...}
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{emailAdmin}}",
  "password": "{{passwordAdmin}}"
}

### A-05 · Login del ADMIN 2
# @name loginAdmin2
# Esperado: 200
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{emailAdmin2}}",
  "password": "{{passwordAdmin}}"
}

### A-06 · Login de la cliente
# @name loginCliente
# Esperado: 200
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{emailCliente}}",
  "password": "{{passwordCliente}}"
}

### A-07 · Ids de los ADMIN (se usan abajo)
# @name yoAdmin
# @no-cookie-jar
# Esperado: 200 {"usuario": {"id": <id>, ...}, "roles_vigentes": ["ADMIN", "CLIENTE"],
#                "roles_token": ["ADMIN", "CLIENTE"]}
GET {{host}}/auth/yo
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

###
# @name yoAdmin2
# @no-cookie-jar
# Esperado: 200 (id del ADMIN 2)
GET {{host}}/auth/yo
Cookie: {{loginAdmin2.response.headers.Set-Cookie}}

### A-08 · Línea SISTEMA visible (precondición de C-06 eventos)
# @no-cookie-jar
# Esperado: 200 {"items": [..., {"id": <id>, "cuando": "...", "actor": "SISTEMA",
#   "accion": "Carga de los datos iniciales"}], "total": <n>, "page": 1, "size": 20,
#   "pages": 1}  (la más reciente primero: aparecen antes los eventos de este archivo)
GET {{host}}/eventos?size=100
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

# ============================================================================
# C-01 · Parámetro de ruta no entero, con sesión
# ============================================================================

### C-01 · GET /usuarios/abc/roles con la cookie de ADMIN → 422, sin ejecutar el handler
# @no-cookie-jar
# Esperado: 422 {"detail": [{"type": "int_parsing", "loc": ["path", "usuario_id"], ...}]}
# Sin cookie sería 401 (la sesión se resuelve antes que los parámetros).
GET {{host}}/usuarios/abc/roles
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

# ============================================================================
# C-09 · Alta de personal y cambio obligatorio de contraseña
# ============================================================================

### C-09a · Alta de un VENDEDOR con contraseña provisoria
# @name altaVendedor
# @no-cookie-jar
# Esperado: 201
# {"id": <id>, "email": "authz.vendedor@example.com", "nombre": "Vendedor Authz",
#  "activo": true, "debe_cambiar_password": true}   (sin password_hash)
# Además: una asignación VENDEDOR abierta con otorgada_por = id del ADMIN 1 y el
# evento «Alta de personal authz.vendedor@example.com con rol VENDEDOR».
POST {{host}}/usuarios
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{
  "email": "{{emailVendedor}}",
  "nombre": "Vendedor Authz",
  "password": "{{passwordProvisoria}}",
  "rol": "VENDEDOR"
}

### C-09b · Mismo correo → 409 propio y sin evento nuevo
# @no-cookie-jar
# Esperado: 409 {"detail": "Ya existe un usuario con ese correo"}
# (sin "uq_", "duplicate key" ni 500). psql: el conteo de eventos «Alta de personal
# authz.vendedor...» sigue en 1:
#   SELECT count(*) FROM evento_seguridad
#    WHERE accion = 'Alta de personal authz.vendedor@example.com con rol VENDEDOR';
POST {{host}}/usuarios
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{
  "email": "{{emailVendedor}}",
  "nombre": "Otro nombre",
  "password": "{{passwordProvisoria}}",
  "rol": "VENDEDOR"
}

### C-09c · rol CLIENTE → 422 (un CLIENTE nace por /auth/registro)
# @no-cookie-jar
# Esperado: 422
POST {{host}}/usuarios
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{
  "email": "authz.otro1@example.com",
  "nombre": "Otro",
  "password": "{{passwordProvisoria}}",
  "rol": "CLIENTE"
}

### C-09d · Campo extra → 422
# @no-cookie-jar
# Esperado: 422
POST {{host}}/usuarios
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{
  "email": "authz.otro2@example.com",
  "nombre": "Otro",
  "password": "{{passwordProvisoria}}",
  "rol": "VENDEDOR",
  "activo": false
}

### C-09e · Contraseña de 73 bytes → 422
# @no-cookie-jar
# Esperado: 422
POST {{host}}/usuarios
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{
  "email": "authz.otro3@example.com",
  "nombre": "Otro",
  "password": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "rol": "VENDEDOR"
}

