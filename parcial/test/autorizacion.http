# ============================================================================
# C-07 · Revocar un rol con la sesión abierta; vencimientos inválidos
# ============================================================================

### C-07a · El vendedor (sesión abierta) ve las ventas
# @no-cookie-jar
# Esperado: 200
GET {{host}}/ventas/
Cookie: {{loginVendedor.response.headers.Set-Cookie}}

### C-07b · El ADMIN revoca el rol VENDEDOR del vendedor
# @no-cookie-jar
# Esperado: 200
# {"id": <id>, "usuario_id": {{altaVendedor.response.body.$.id}}, "rol": "VENDEDOR",
#  "desde": "...", "vence_en": null, "revocada_en": "<ahora>", "otorgada_por": <id admin 1>,
#  "vigente": false}
DELETE {{host}}/usuarios/{{altaVendedor.response.body.$.id}}/roles/VENDEDOR
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-07c · La MISMA cookie del vendedor → 403 en la petición siguiente
# @no-cookie-jar
# Esperado: 403 {"detail": "No tenés permiso para esta operación"}
GET {{host}}/ventas/
Cookie: {{loginVendedor.response.headers.Set-Cookie}}

### C-07d · /auth/yo del vendedor: los roles de la base ya no incluyen VENDEDOR; el token sí
# @no-cookie-jar
# Esperado: 200 {"usuario": {...}, "roles_vigentes": [], "roles_token": ["VENDEDOR"]}
GET {{host}}/auth/yo
Cookie: {{loginVendedor.response.headers.Set-Cookie}}

### C-07e · Historial: la fila revocada sigue, con revocada_en y vigente=false
# @no-cookie-jar
# Esperado: 200 [{"id": <id>, "usuario_id": ..., "rol": "VENDEDOR", "desde": "...",
#   "vence_en": null, "revocada_en": "<fecha>", "otorgada_por": <id admin 1>,
#   "vigente": false}]
GET {{host}}/usuarios/{{altaVendedor.response.body.$.id}}/roles
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-07f · vence_en sin zona horaria → 422
# @no-cookie-jar
# Esperado: 422 (AwareDatetime: no llega a la base)
POST {{host}}/usuarios/{{altaVendedor.response.body.$.id}}/roles
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{"rol": "VENDEDOR", "vence_en": "2030-01-01T00:00:00"}

### C-07g · vence_en en el pasado → 422
# @no-cookie-jar
# Esperado: 422
POST {{host}}/usuarios/{{altaVendedor.response.body.$.id}}/roles
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{"rol": "VENDEDOR", "vence_en": "2020-01-01T00:00:00Z"}

### C-07h · Asignar VENDEDOR de nuevo → 201
# @no-cookie-jar
# Esperado: 201 {"id": <id>, "usuario_id": ..., "rol": "VENDEDOR", "desde": "...",
#   "vence_en": null, "revocada_en": null, "otorgada_por": <id admin 1>, "vigente": true}
POST {{host}}/usuarios/{{altaVendedor.response.body.$.id}}/roles
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{"rol": "VENDEDOR"}

### C-07i · Repetirlo → 409 propio (lo rechaza el índice único parcial)
# @no-cookie-jar
# Esperado: 409 {"detail": "El usuario ya tiene ese rol vigente"}
# (sin texto de la base). psql: una sola asignación VENDEDOR abierta:
#   SELECT count(*) FROM asignacion_rol
#    WHERE usuario_id = {{altaVendedor.response.body.$.id}} AND rol = 'VENDEDOR'
#      AND revocada_en IS NULL;   → 1
POST {{host}}/usuarios/{{altaVendedor.response.body.$.id}}/roles
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{"rol": "VENDEDOR"}

### C-07j-1 · Preparar la fila vencida: revocar la VENDEDOR de C-07h
# @no-cookie-jar
# Esperado: 200 (vigente=false)
DELETE {{host}}/usuarios/{{altaVendedor.response.body.$.id}}/roles/VENDEDOR
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-07j-2 · Asignar VENDEDOR con vence_en futuro
# @no-cookie-jar
# Esperado: 201 {..., "vence_en": "2099-01-01T00:00:00-03:00", "revocada_en": null, "vigente": true}
# (la respuesta del POST repite la fecha tal como se envió; el GET de roles la devuelve en UTC)
POST {{host}}/usuarios/{{altaVendedor.response.body.$.id}}/roles
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{"rol": "VENDEDOR", "vence_en": "2099-01-01T00:00:00-03:00"}

### C-07j-3 · Fabricar la fila vencida con psql (la API la rechaza con 422 a propósito)
# Correr en psql y recién después el pedido siguiente:
#   UPDATE asignacion_rol SET vence_en = now() - interval '1 minute'
#    WHERE usuario_id = {{altaVendedor.response.body.$.id}} AND rol = 'VENDEDOR'
#      AND revocada_en IS NULL;
# La fila sigue «abierta» (revocada_en NULL) pero ya no vale.
# Mientras esté así, revocarla (DELETE) da 404 «no tiene ese rol vigente» (QA-04).

### C-07k · Reasignar con la fila vencida abierta → 201 y la anterior queda cerrada
# @no-cookie-jar
# Esperado: 201 (vigente=true). psql: la fila vencida ahora tiene revocada_en = <ahora>
# y hay una sola VENDEDOR abierta:
#   SELECT id, desde, vence_en, revocada_en FROM asignacion_rol
#    WHERE usuario_id = {{altaVendedor.response.body.$.id}} AND rol = 'VENDEDOR' ORDER BY id;
POST {{host}}/usuarios/{{altaVendedor.response.body.$.id}}/roles
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{"rol": "VENDEDOR"}

### C-07l · Usuario inexistente → 404
# @no-cookie-jar
# Esperado: 404 {"detail": "Usuario no encontrado"}
POST {{host}}/usuarios/2147483647/roles
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{"rol": "VENDEDOR"}

### C-07m · Revocar un rol que el usuario no tiene vigente → 404
# @no-cookie-jar
# Esperado: 404 {"detail": "El usuario no tiene ese rol vigente"}
DELETE {{host}}/usuarios/{{altaVendedor.response.body.$.id}}/roles/ADMIN
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-07n · Rol fuera del enum en la ruta → 422
# @no-cookie-jar
# Esperado: 422
DELETE {{host}}/usuarios/{{altaVendedor.response.body.$.id}}/roles/GERENTE
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-07o · Eventos: una línea por cada asignación/revocación con éxito y ninguna por las rechazadas
# @no-cookie-jar
# Esperado: 200; en los primeros items, del más nuevo al más viejo:
#  «Asignación de rol VENDEDOR a authz.vendedor@example.com», (la de vence_en, con « hasta ...»),
#  «Revocación de rol VENDEDOR a ...», «Asignación ...», «Revocación ...», «Alta de personal ...».
# Los 409/404/422 de arriba no dejaron ninguna.
GET {{host}}/eventos?size=20
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

# ============================================================================
# C-08 · Autoprotección (RN-05)
# ============================================================================

### C-08a · El ADMIN 1 intenta revocar su propio ADMIN → 409 y sigue vigente
# @no-cookie-jar
# Esperado: 409 {"detail": "No podés revocarte tu propio rol ADMIN"}
DELETE {{host}}/usuarios/{{yoAdmin.response.body.$.usuario.id}}/roles/ADMIN
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-08b · Sigue siendo ADMIN
# @no-cookie-jar
# Esperado: 200 con "ADMIN" en roles_vigentes
GET {{host}}/auth/yo
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-08c · El ADMIN 1 revoca el ADMIN del ADMIN 2 → 200
# @no-cookie-jar
# Esperado: 200 {..., "rol": "ADMIN", "revocada_en": "<ahora>", "vigente": false}
DELETE {{host}}/usuarios/{{yoAdmin2.response.body.$.usuario.id}}/roles/ADMIN
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-08d · Se lo reasigna para dejar el estado inicial → 201
# @no-cookie-jar
# Esperado: 201 {"rol": "ADMIN", "vigente": true, ...}
POST {{host}}/usuarios/{{yoAdmin2.response.body.$.usuario.id}}/roles
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{"rol": "ADMIN"}

# ----------------------------------------------------------------------------
# Revocación cruzada simultánea (no es caso del PDF; demuestra el FOR UPDATE de D8)
# ----------------------------------------------------------------------------
# Con exactamente dos ADMIN vigentes (A = authz.admin, B = authz.admin2) y dos
# terminales psql:
#
#   psql 1:  BEGIN;
#            SELECT * FROM asignacion_rol ar JOIN usuario u ON u.id = ar.usuario_id
#             WHERE ar.rol = 'ADMIN' AND ar.revocada_en IS NULL AND u.activo
#               FOR UPDATE OF ar;                      -- (sin COMMIT todavía)
#
#   REST Client:  DELETE /usuarios/<id de B>/roles/ADMIN   con la cookie de A
#                 → el pedido queda ESPERANDO (el lock lo tiene psql 1).
#
#   psql 1:  UPDATE asignacion_rol SET revocada_en = now()
#             WHERE usuario_id = <id de A> AND rol = 'ADMIN' AND revocada_en IS NULL;
#            COMMIT;
#
#   Al confirmar psql 1, PostgreSQL re-evalúa el WHERE: el único otro ADMIN vigente
#   (A) ya no lo es → el pedido que esperaba responde 409
#   {"detail": "El sistema no puede quedar sin administradores vigentes"}
#   y B conserva su ADMIN.
#
# Fin: limpiar las filas de prueba con el SQL de las precondiciones.
