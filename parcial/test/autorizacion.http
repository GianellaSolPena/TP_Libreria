# Esperado: 200 {"mensaje": "Sesión iniciada", "debe_cambiar_password": true, ...}
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{emailVendedor}}",
  "password": "{{passwordProvisoria}}"
}

