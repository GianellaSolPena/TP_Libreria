# ============================================================================
# C-06 · 401 contra 403 (la parte «la cliente ve su venta» llega con C-07)
# ============================================================================

### C-06a · POST /libros/ sin cookie → 401
# Esperado: 401 {"detail": "No autenticado"}
POST {{host}}/libros/
Content-Type: application/json

{"isbn": "authz-0001", "titulo": "authz.libro.sin.sesion", "precio": "10.00",
 "stock": 1, "editorial_id": 1, "autores": []}

### C-06b · POST /libros/ con la cookie del vendedor → 403 y no se crea el libro
# @no-cookie-jar
# Esperado: 403 {"detail": "No tenés permiso para esta operación"}
# psql: SELECT count(*) FROM libro WHERE titulo LIKE 'authz.%';  → 0
# (el 403 sale antes que la validación del cuerpo: aunque el cuerpo tuviera un
#  error, un VENDEDOR no llega a verlo.)
POST {{host}}/libros/
Content-Type: application/json
Cookie: {{loginVendedor.response.headers.Set-Cookie}}

{"isbn": "authz-0002", "titulo": "authz.libro.vendedor", "precio": "10.00",
 "stock": 1, "editorial_id": 1, "autores": []}

### C-06c · POST /generos con la cookie de la cliente → 403 y no se crea el género
# @no-cookie-jar
# Esperado: 403 {"detail": "No tenés permiso para esta operación"}
# psql: SELECT count(*) FROM genero WHERE nombre LIKE 'authz.%';  → 0
POST {{host}}/generos
Content-Type: application/json
Cookie: {{loginCliente.response.headers.Set-Cookie}}

{"nombre": "authz.genero.cliente"}

