# El archivo .env NO se versiona. Copiá este archivo como .env y completá los valores.
POSTGRES_USER=libreria
POSTGRES_PASSWORD=
POSTGRES_DB=libreria
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SQL_ECHO=false
DB_POOL_SIZE=5
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_SECONDS=1800
BCRYPT_ROUNDS=12
# true cuando se sirve detrás de HTTPS
COOKIE_SECURE=false
